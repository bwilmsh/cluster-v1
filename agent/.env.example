GROQ_API_KEY=
TAVILY_API_KEY=tvly-...
CAL_API_KEY=cal_live_...
CAL_API_BASE_URL=https://api.cal.com
CAL_API_VERSION=2026-02-25
# Set one booking target:
# CAL_EVENT_TYPE_ID=123
# or:
# CAL_EVENT_TYPE_SLUG=my-event-type
# CAL_USERNAME=john-doe
# or (auto-resolve by title if IDs rotate):
# CAL_EVENT_TYPE_NAME=Haircut
# Optional: set true only if you want the agent to call /v2/event-types.
# Default behavior is explicit config only (recommended).
# CAL_ALLOW_EVENT_TYPE_DISCOVERY=false
# Optional:
# CAL_TEAM_SLUG=my-team
# CAL_ORGANIZATION_SLUG=my-org
# CAL_TIMEZONE=UTC
AGENT_PORT=8000
PRISMATIC_ORG_ID=your-prismatic-organization-id
PRISMATIC_PRIVATE_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
PRISMATIC_USER_ID=your-user-id
PRISMATIC_EXTERNAL_CUSTOMER_ID=your-external-customer-id
