# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cal.com
CAL_API_KEY=cal_live_...
CAL_API_VERSION=2026-02-25
# Set one booking target:
# CAL_EVENT_TYPE_ID=123
# or:
# CAL_EVENT_TYPE_SLUG=my-event-type
# CAL_USERNAME=john-doe
# or (auto-resolve by title if IDs rotate):
# CAL_EVENT_TYPE_NAME=Haircut
# Optional:
# CAL_TEAM_SLUG=my-team
# CAL_ORGANIZATION_SLUG=my-org
# CAL_TIMEZONE=UTC

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/cluster

# Service URLs
PYTHON_SERVICE_URL=http://localhost:8000

# Ports (defaults)
BACKEND_PORT=3001
AGENT_PORT=8000
FRONTEND_PORT=3000

JWT_SECRET=change-me-in-production
