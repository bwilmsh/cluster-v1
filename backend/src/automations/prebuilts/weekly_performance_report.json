{
  "id": "weekly_performance_report",
  "name": "Weekly Performance Report",
  "description": "Comprehensive weekly business report pulling from email, sheets, and social media",
  "category": "analytics",
  "icon": "chart",
  "requires": ["google_oauth"],
  "variables": [
    { "key": "report_name", "label": "Report title", "type": "text", "default": "Weekly Performance Report", "placeholder": "My Weekly Report" },
    { "key": "sheet_url", "label": "Metrics sheet URL (optional)", "type": "text", "placeholder": "https://docs.google.com/spreadsheets/d/..." }
  ],
  "steps": [
    { "id": 1, "type": "api", "action": "list_emails", "provider": "google", "endpoint": "gmail.users.messages.list", "params": { "maxResults": "100", "q": "is:inbox newer_than:7d" } },
    { "id": 2, "type": "extract", "action": "process", "target": "email_summary", "source": "api_result" },
    { "id": 3, "type": "report", "action": "summarise", "format": "weekly_report", "include": ["email_volume", "leads_received", "key_conversations", "action_items"] }
  ],
  "delivery_options": ["chat", "group_chat", "email", "sheets", "slack"],
  "estimated_duration": "30-45 seconds",
  "ai_recovery": false
}
