generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  passwordHash    String?          // nullable — existing users have none
  plan            Plan             @default(FREE)
  createdAt       DateTime         @default(now())
  agents          Agent[]
  groupChats      GroupChat[]
  messages        Message[]
  integrations    Integration[]
  oauthConfigs    OAuthConfig[]
  widgets         Widget[]
  goals           Goal[]
  webCredentials  WebCredential[]
  automations      Automation[]
  browseActivities BrowseActivity[]
  workflows        Workflow[]
}

enum Plan {
  FREE
  PRO
  MAX
}

model OAuthConfig {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   // "google" | "slack" | "notion"
  clientId     String   // encrypted
  clientSecret String   // encrypted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider])
}

model Integration {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String    // "google" | "slack" | "notion"
  accessToken  String    // AES-256-GCM encrypted
  refreshToken String?   // AES-256-GCM encrypted
  accountEmail String?
  accountName  String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
}

model Widget {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  type        String    // "stat" | "agents_grid" | "activity_feed" | "agent_memory" | "text"
  config      Json      @default("{}")
  size        String    @default("md") // "sm" | "md" | "lg"
  order       Int       @default(0)
  lastData    Json?
  lastUpdated DateTime?
  createdAt   DateTime  @default(now())
}

model Agent {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  name           String
  setupAnswers   Json?
  memory         String?
  status         String          @default("active")
  createdAt      DateTime        @default(now())
  messages       Message[]
  groupMembers   GroupChatMember[]
  files          AgentFile[]
  automations    Automation[]
}

model WebCredential {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteName  String
  siteUrl   String
  username  String
  password  String   // AES-256-GCM encrypted
  createdAt DateTime @default(now())
}

model AutomationTemplate {
  id          String       @id
  name        String
  description String
  category    String
  icon        String?
  isOfficial  Boolean      @default(false)
  isApproved  Boolean      @default(false)
  definition  Json
  createdBy   String?
  createdAt   DateTime     @default(now())
  automations Automation[]
}

model Automation {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  templateId     String?
  template       AutomationTemplate? @relation(fields: [templateId], references: [id])
  name           String
  goal           String?
  variables      Json                @default("{}")
  schedule       String?
  active         Boolean             @default(true)
  deliveryType   String              @default("chat")
  deliveryTarget String?
  lastRunAt      DateTime?
  lastRunStatus  String?
  lastRunResult  String?
  createdAt      DateTime            @default(now())
  runs           AutomationRun[]
}

model AutomationRun {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  status       String
  steps        Json       @default("[]")
  finalResult  String?
  deliveredTo  String?
}

model BrowseActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String?
  agentName String?
  url       String
  domain    String
  summary   String?
  createdAt DateTime @default(now())
}

model AgentFile {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fileName  String
  fileType  String   // "csv" | "sheet"
  content   String
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())
}

model GroupChat {
  id        String            @id @default(cuid())
  name      String
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  members   GroupChatMember[]
  messages  GroupChatMessage[]
}

model GroupChatMember {
  id          String    @id @default(cuid())
  groupChatId String
  groupChat   GroupChat @relation(fields: [groupChatId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       Agent?    @relation(fields: [agentId], references: [id])
  userId      String?
  type        String
}

model GroupChatMessage {
  id          String    @id @default(cuid())
  groupChatId String
  groupChat   GroupChat @relation(fields: [groupChatId], references: [id], onDelete: Cascade)
  senderName  String
  senderRole  String
  role        String
  content     String
  createdAt   DateTime  @default(now())
}

model Workflow {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  nodes       Json          @default("[]")
  edges       Json          @default("[]")
  status      String        @default("draft")  // "draft" | "active" | "paused"
  lastRunAt   DateTime?
  lastRunStatus String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        WorkflowRun[]
}

model WorkflowRun {
  id          String    @id @default(cuid())
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    // "running" | "success" | "failed"
  result      String?
}

model Goal {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalText        String
  isActive        Boolean  @default(true)
  visibleAgentIds Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Event {
  id              String    @id @default(cuid())
  title           String
  description     String?
  start_time      DateTime
  end_time        DateTime?
  location        String?
  google_event_id String?
  itemType        String?   // "event" | "task" | "appointment"
  status          String    @default("todo") // "todo" | "in-progress" | "done" | custom
  priority        String    @default("medium") // "low" | "medium" | "high"
  reminderTime    DateTime?
  reminderSent    Boolean   @default(false)
  assignee        String?
  tags            String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
