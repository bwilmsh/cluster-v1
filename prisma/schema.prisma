generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  passwordHash    String?          // nullable — existing users have none
  plan            Plan             @default(FREE)
  createdAt       DateTime         @default(now())
  agents          Agent[]
  groupChats      GroupChat[]
  messages        Message[]
  integrations    Integration[]
  oauthConfigs    OAuthConfig[]
  widgets         Widget[]
  goals           Goal[]
  habits          Habit[]
  dueDates        DueDate[]
  webCredentials  WebCredential[]
  automations      Automation[]
  scheduledEmails  ScheduledEmail[]
  browseActivities BrowseActivity[]
  workflows        Workflow[]
}

enum Plan {
  FREE
  PRO
  MAX
}

model OAuthConfig {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   // "google" | "slack" | "notion"
  clientId     String   // encrypted
  clientSecret String   // encrypted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider])
}

model Integration {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String    // "google" | "slack" | "notion"
  accessToken  String    // AES-256-GCM encrypted
  refreshToken String?   // AES-256-GCM encrypted
  accountEmail String?
  accountName  String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
}

model Widget {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  type        String    // "stat" | "agents_grid" | "activity_feed" | "agent_memory" | "text"
  config      Json      @default("{}")
  size        String    @default("md") // "sm" | "md" | "lg"
  order       Int       @default(0)
  lastData    Json?
  lastUpdated DateTime?
  createdAt   DateTime  @default(now())
}

model Agent {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  name           String
  setupAnswers   Json?
  memory         String?
  status         String          @default("active")
  createdAt      DateTime        @default(now())
  messages       Message[]
  groupMembers   GroupChatMember[]
  files          AgentFile[]
  automations    Automation[]
}

model WebCredential {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteName  String
  siteUrl   String
  username  String
  password  String   // AES-256-GCM encrypted
  createdAt DateTime @default(now())
}

model AutomationTemplate {
  id          String       @id
  name        String
  description String
  category    String
  icon        String?
  isOfficial  Boolean      @default(false)
  isApproved  Boolean      @default(false)
  definition  Json
  createdBy   String?
  createdAt   DateTime     @default(now())
  automations Automation[]
}

model Automation {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  templateId     String?
  template       AutomationTemplate? @relation(fields: [templateId], references: [id])
  name           String
  goal           String?
  variables      Json                @default("{}")
  schedule       String?
  active         Boolean             @default(true)
  deliveryType   String              @default("chat")
  deliveryTarget String?
  lastRunAt      DateTime?
  lastRunStatus  String?
  lastRunResult  String?
  createdAt      DateTime            @default(now())
  runs           AutomationRun[]
}

model AutomationRun {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  status       String
  steps        Json       @default("[]")
  finalResult  String?
  deliveredTo  String?
}

model BrowseActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String?
  agentName String?
  url       String
  domain    String
  summary   String?
  createdAt DateTime @default(now())
}

model AgentFile {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fileName  String
  fileType  String   // "csv" | "sheet"
  content   String
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())
}

model GroupChat {
  id        String            @id @default(cuid())
  name      String
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  members   GroupChatMember[]
  messages  GroupChatMessage[]
}

model GroupChatMember {
  id          String    @id @default(cuid())
  groupChatId String
  groupChat   GroupChat @relation(fields: [groupChatId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       Agent?    @relation(fields: [agentId], references: [id])
  userId      String?
  type        String
}

model GroupChatMessage {
  id          String    @id @default(cuid())
  groupChatId String
  groupChat   GroupChat @relation(fields: [groupChatId], references: [id], onDelete: Cascade)
  senderName  String
  senderRole  String
  role        String
  content     String
  createdAt   DateTime  @default(now())
}

model Workflow {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  nodes       Json          @default("[]")
  edges       Json          @default("[]")
  status      String        @default("draft")  // "draft" | "active" | "paused"
  lastRunAt   DateTime?
  lastRunStatus String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        WorkflowRun[]
}

model WorkflowRun {
  id          String    @id @default(cuid())
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    // "running" | "success" | "failed"
  result      String?
}

model Goal {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalText        String
  deadline        DateTime?
  isActive        Boolean  @default(true)
  visibleAgentIds Json     @default("[]")
  autoRun         DueDateAutoRun?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Habit {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  notes         String?
  frequency     HabitFrequency @default(DAILY)
  idealTime     HabitIdealTime @default(MORNING)
  timeRangeStart String?
  timeRangeEnd  String?
  daysOfWeek    String[] @default([])
  isActive      Boolean  @default(true)
  autoReschedule Boolean @default(true)
  keywords      String[] @default([])
  priorityLevel HabitPriority @default(MEDIUM)
  color         String?
  streak        Int      @default(0)
  longestStreak  Int      @default(0)
  priority      Int      @default(3)
  rrule         String?   // RFC5545 rrule string for complex recurrence patterns
  cadence       String?   // friendly cadence like "daily" | "weekly" (fallback)
  timeOfDay     String?   // window start time like "08:30:00" (optional)
  endTime       String?   // window end time like "09:00:00"
  durationMinutes Int      @default(30)
  timezone      String?   // IANA timezone identifier
  active        Boolean   @default(true)
  materialize   Boolean   @default(true) // whether to create Event occurrences
  showAsBusy    Boolean   @default(true)
  hideDetails   Boolean   @default(false)
  scheduleReason String?
  skippedDates  Json      @default("[]") // ISO date strings (YYYY-MM-DD) skipped for this habit
  lastCompleted DateTime?
  events        Event[]
  entries       HabitEntry[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum HabitFrequency {
  DAILY
  WEEKDAYS
  WEEKLY
  CUSTOM
}

enum HabitIdealTime {
  MORNING
  AFTERNOON
  EVENING
}

enum HabitPriority {
  LOW
  MEDIUM
  HIGH
}

enum DueDatePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DueDateStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum DueDateCategory {
  ASSIGNMENT
  EXAM
  WORK
  PERSONAL
}

enum HabitEntryStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
  RESCHEDULED
}

model HabitEntry {
  id              String            @id @default(cuid())
  habitId         String
  habit           Habit             @relation(fields: [habitId], references: [id], onDelete: Cascade)
  scheduledDate   DateTime
  scheduledStart  DateTime
  scheduledEnd    DateTime
  status          HabitEntryStatus  @default(SCHEDULED)
  wasRescheduled  Boolean           @default(false)
  completedAt     DateTime?
  event           Event?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([habitId, scheduledDate])
  @@index([habitId, scheduledDate])
}

model Event {
  id              String    @id @default(cuid())
  title           String
  description     String?
  start_time      DateTime
  end_time        DateTime?
  location        String?
  google_event_id String?
  itemType        String?   // "event" | "task" | "appointment" | "habit"
  status          String    @default("todo") // "todo" | "in-progress" | "done" | custom
  priority        String    @default("medium") // "low" | "medium" | "high"
  reminderTime    DateTime?
  reminderSent    Boolean   @default(false)
  assignee        String?
  tags            String[]  @default([])
  habitId         String?
  habit           Habit?    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  habitOccurrenceAt DateTime?
  habitLocked     Boolean   @default(false)
  showAsBusy      Boolean   @default(true)
  hideDetails     Boolean   @default(false)
  scheduleReason  String?
  habitEntryId    String?   @unique
  habitEntry      HabitEntry? @relation(fields: [habitEntryId], references: [id], onDelete: SetNull)
  autoRun         DueDateAutoRun?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([habitId])
  @@index([habitOccurrenceAt])
}

model DueDateAutoRun {
  id          String   @id @default(cuid())
  eventId     String?  @unique
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  goalId      String?  @unique
  goal        Goal?    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(false)
  actionType  String   // "sendEmail" | "createCalendarEvent" | "markTaskComplete" | "sendNotification"
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ScheduledEmail {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  to             String
  subject        String
  body           String
  sendAt         DateTime
  status         String   @default("scheduled") // "scheduled" | "sending" | "sent" | "failed"
  sentAt         DateTime?
  gmailMessageId String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, status, sendAt])
  @@index([sendAt])
}

model DueDate {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime
  dueTime     String
  priority    DueDatePriority  @default(MEDIUM)
  status      DueDateStatus    @default(PENDING)
  category    DueDateCategory  @default(PERSONAL)
  createdAt   DateTime         @default(now())

  @@index([userId, dueDate])
  @@index([userId, status])
}
